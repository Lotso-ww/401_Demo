QMainWindow { background: #17191c; color: #eceff1; }
QWidget { font-family: "Microsoft YaHei"; font-size: 13px; }
QFrame#topBar, QFrame#sidePanel { background: #21252a; color: #f4f6f8; }
QLabel#pageTitle { font-size: 20px; font-weight: 600; color: #f4f6f8; }
QPushButton { background: #e8edf1; border: 1px solid #bac4cc; border-radius: 4px; padding: 7px 11px; min-height: 20px; }
QPushButton:hover { background: #d9e2e9; }
QPushButton:checked, QPushButton#primary { background: #2378c3; border-color: #2378c3; color: white; }
QFrame#chamberCard { background: white; border: 1px solid #bdced1; border-radius: 4px; }
QPushButton#chamberSelect { background: #315158; border: 0; color: white; font-size: 16px; font-weight: 600; min-width: 72px; }
QPushButton#chamberSelect:checked { background: #15757d; border: 2px solid #0f6168; }
QLabel#chamberState { color: #61747a; font-weight: 600; }
QLabel#chamberDetails { color: #33484e; }
QPushButton#homeWell { background: #d9e1e2; border: 1px solid #b3c3c5; border-radius: 3px; padding: 0; min-width: 0; color: #41545a; }
QPushButton#homeWell[captureState="complete"] { background: #75939a; color: white; }
QPushButton#homeWell[captureState="current"] { background: #2f9c65; border: 2px solid #125e38; color: white; font-weight: 700; }
QGroupBox { border: 1px solid #c8d4d6; border-radius: 5px; margin-top: 12px; padding: 10px; font-weight: 600; background: white; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; }
QLabel#statusReady { color: #1f7560; font-weight: 600; }
QLabel#statusBusy { color: #a86513; font-weight: 600; }
QLabel#statusError { color: #b13c42; font-weight: 600; }
QLabel#sectionTitle { font-size: 19px; font-weight: 600; }
QLabel#mutedText { color: #61747a; }
QFrame#homeActions { background: #e7eef0; border: 1px solid #bdced1; border-radius: 4px; }

QWidget#homeDashboard { background: #17191c; }
QFrame#dashboardChamberCard { background: #292d32; border: 1px solid #3b4148; border-radius: 7px; }
QPushButton#dashboardChamberSelect {
    background: transparent; border: 0; color: #efefef; font-size: 22px; font-weight: 600;
    min-width: 86px; padding: 0; text-align: left;
}
QPushButton#dashboardChamberSelect:checked { color: #ffffff; }
QLabel#dashboardChamberState { color: #66d49a; font-size: 13px; font-weight: 600; }
QLabel#dashboardChamberState[activity="recognizing"] { color: #58aef5; font-size: 15px; }
QLabel#dashboardChamberDetails { color: #f1f1f1; font-size: 17px; font-weight: 600; }
QPushButton#homeWellThumbnail {
    background: #101214; border: 1px solid #434a52; border-radius: 3px; color: #a9a9a9;
    font-size: 11px; padding: 0;
}
QPushButton#homeWellThumbnail:hover { border-color: #259ce8; }
QPushButton#homeWellThumbnail[captureState="complete"] { border-color: #65717c; }
QPushButton#homeWellThumbnail[captureState="current"] { border: 2px solid #3ad477; }
QFrame#homeActions { background: #21252a; border: 1px solid #3b4148; border-radius: 5px; }
QWidget#homeDashboard QPushButton#primary { background: #2378c3; border-color: #2378c3; color: white; }

QWidget#clinicalPage { background: #292d32; color: #ececec; }
QWidget#clinicalPage QLabel { color: #ececec; font-size: 15px; }
QFrame#dishChamberPanel, QFrame#wellSelector { background: #202428; border: 1px solid #3c434b; }
QPushButton#chamberNavButton, QPushButton#wellNavButton {
    background: #2b3036; border: 0; border-radius: 4px; color: #eeeeee;
    font-size: 18px; padding: 4px;
}
QPushButton#chamberNavButton:checked, QPushButton#wellNavButton:checked {
    background: #46515c; color: white;
}
QPushButton#chamberNavButton:disabled { color: #555555; background: #252525; }
QFrame#patientPanel { background: #292d32; border: 0; }
QLabel#wellInfo { color: #d8d8d8; font-size: 15px; line-height: 1.45; }
QPushButton#returnButton {
    background: #777777; border: 0; border-radius: 7px; color: white;
    font-size: 28px; padding: 0 0 4px 0;
}
QPushButton#returnButton:hover { background: #8b8b8b; }
QFrame#thumbnailArea { background: #202428; border: 0; }
QPushButton#dishWellThumbnail {
    background: #101214; border: 1px solid #3b434c; border-radius: 0; color: #bcbcbc;
    font-size: 12px; font-weight: 600; padding: 2px; text-align: left top;
}
QPushButton#dishWellThumbnail:hover { border-color: #43a7ec; }
QPushButton#dishWellThumbnail:checked { border: 2px solid #38a5f5; }
QPushButton#mediaButton {
    background: transparent; border: 0; border-radius: 3px; color: #f5f5f5;
    font-size: 18px; padding: 0;
}
QPushButton#mediaButton:hover { background: #505050; }
QComboBox#speedSelector, QWidget#clinicalPage QComboBox {
    background: #f8f8f8; border: 1px solid #bcbcbc; border-radius: 4px; color: #444;
    min-height: 22px; padding: 0 5px;
}
QLabel#timelineLabel { color: #c5c5c5; font-size: 12px; min-width: 100px; }
QSlider#timelineSlider::groove:horizontal { height: 8px; background: #e6e6e6; border-radius: 4px; }
QSlider#timelineSlider::sub-page:horizontal { background: #e6e6e6; border-radius: 4px; }
QSlider#timelineSlider::handle:horizontal { width: 14px; margin: -4px 0; background: #37a1ed; border-radius: 7px; }
QPushButton#modeTab {
    background: #555555; border: 1px solid #707070; border-radius: 4px; color: #eeeeee;
    min-height: 27px; padding: 4px 9px; font-size: 14px;
}
QPushButton#modeTab:checked { background: #292929; border-color: #707070; color: white; }
QLabel#imagePreview, QLabel#calibrationPreview {
    background: #0c0d0f; border: 1px solid #4a4a4a; color: #cacaca;
}
QPushButton#adjustButton {
    background: #339df0; border: 0; border-radius: 6px; color: white;
    font-size: 25px; min-width: 50px; min-height: 40px; padding: 0 0 4px 0;
}
QPushButton#adjustButton:hover { background: #58aff2; }
QSpinBox#axisValue {
    background: #fafafa; border: 1px solid #d1d1d1; border-radius: 6px; color: #303030;
    min-width: 70px; min-height: 36px; font-size: 16px; padding: 0 5px;
}
QSpinBox#axisValue::up-button, QSpinBox#axisValue::down-button { width: 0; border: 0; }
QPushButton#stepPreset {
    background: transparent; border: 1px solid #777777; border-radius: 21px; color: #b8b8b8;
    padding: 0; font-size: 13px;
}
QPushButton#stepPreset:checked { background: #339df0; border-color: #339df0; color: white; }
QPushButton#saveButton { background: #339df0; border: 0; border-radius: 6px; color: white; font-size: 20px; }
