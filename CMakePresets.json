{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "D:/QT5/5.14.2/msvc2017",
        "CMAKE_CXX_STANDARD": "17",
        "IDS_PEAK_ROOT": "$env{IDS_PEAK_ROOT}",
        "RFID_SDK_ROOT": "$env{RFID_SDK_ROOT}",
        "RFID_RUNTIME_ROOT": "D:/Gitee.code/qt-learning/code/hf_R-Tool/R-TOOL_V1.8.1.4"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } }
  ]
}
